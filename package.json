{
    "name": "com.singtaa.onejs",
    "version": "3.2.2",
    "displayName": "OneJS",
    "description": "JavaScript runtime for Unity UI Toolkit. Write UI with React and TypeScript, render natively through Unity's GPU-accelerated UI system.",
    "unity": "6000.3",
    "unityRelease": "0f1",
    "dependencies": {
        "com.unity.ugui": "2.0.0",
        "com.unity.modules.uielements": "1.0.0",
        "com.unity.modules.imgui": "1.0.0",
        "com.unity.modules.jsonserialize": "1.0.0",
        "com.unity.modules.vectorgraphics": "1.0.0",
        "com.unity.modules.unitywebrequest": "1.0.0",
        "com.unity.modules.unitywebrequesttexture": "1.0.0",
        "com.unity.modules.unitywebrequestaudio": "1.0.0",
        "com.unity.modules.audio": "1.0.0",
        "com.unity.modules.physics": "1.0.0",
        "com.unity.modules.physics2d": "1.0.0",
        "com.unity.modules.animation": "1.0.0"
    },
    "keywords": [
        "javascript",
        "react",
        "typescript",
        "ui",
        "uitoolkit",
        "quickjs"
    ],
    "author": {
        "name": "Singtaa",
        "url": "https://github.com/Singtaa"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Singtaa/OneJS.git"
    },
    "license": "MIT",
    "samples": [
        {
            "displayName": "Particles Demo",
            "description": "2D particle engine showcase (fountain, click burst, pointer trail) packaged as a UI Cartridge. Drag the cartridge onto your JSRunner to extract the TSX component into your app.",
            "path": "Samples~/ParticlesDemo"
        }
    ]
}
