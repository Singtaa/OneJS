<linker>
    <!--
        Preserve types that OneJS accesses only via reflection (CS proxy from JS,
        or runtime reflection in C#). IL2CPP managed-code stripping (default in
        WebGL/iOS/Mobile Release builds) removes anything that isn't statically
        referenced, which breaks reflection-only access at runtime.
    -->

    <!-- Unity UI Toolkit internals used by Runtime/Styling/StyleSheetBuilderWrapper.cs.
         Without these, Activator.CreateInstance(null) throws during JSRunner init. -->
    <assembly fullname="UnityEngine.UIElementsModule">
        <type fullname="UnityEngine.UIElements.StyleSheets.StyleSheetBuilder" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleSheets.Dimension" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleValueKeyword" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleValueType" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleValueFunction" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleSelectorPart" preserve="all"/>
        <type fullname="UnityEngine.UIElements.StyleSelectorRelationship" preserve="all"/>
        <!-- Unity's USS function table and its step from a function to a filter,
             reached by reflection from Runtime/Styling: UssCompiler compiles blur()
             in a sheet through the first, UssFilter reads an inline filter through
             both. No player code calls FromUssString, so High stripping removed it
             and every filter from compileStyleSheet, a CSS module or a JSX style
             was dropped in a build (FilterStylesPlayerBuild in the container). -->
        <type fullname="UnityEngine.UIElements.StyleValueFunctionExtension">
            <method name="FromUssString"/>
        </type>
        <type fullname="UnityEngine.UIElements.StyleProperty">
            <method name="ToFilterFunctionType"/>
        </type>
        <!-- PointerCaptureHelper is reached from JS as a static class wrapping
             extension methods (CapturePointer/ReleasePointer). The methods can
             be stripped because no C# code references them. -->
        <type fullname="UnityEngine.UIElements.PointerCaptureHelper" preserve="all"/>
    </assembly>

    <!-- OneJS's own runtime, whole. JS reaches it by name through the CS proxy
         (StyleBridge, PainterBridge, ParticleBridge, QuickJSUIBridge's
         CompileStyleSheet, Network and the rest), which the linker cannot see,
         so at Medium or High stripping a WebGL build lost them and the app
         rendered nothing ("Type not found: OneJS.StyleBridge"). Naming types
         one at a time was how this broke: the next bridge is always the one
         missing from the list. The optional assemblies are reached the same
         way (onejs-play's models and host input) and are only there when their
         package is, hence ignoreIfMissing. -->
    <assembly fullname="OneJS.Runtime" preserve="all"/>
    <assembly fullname="OneJS.Runtime.Models" preserve="all" ignoreIfMissing="1"/>
    <assembly fullname="OneJS.Runtime.InputSystem" preserve="all" ignoreIfMissing="1"/>

    <!-- BCL IO types reached only via the CS proxy from JS (e.g. the
         onejs-react image/SVG asset loader: CS.System.IO.Path / CS.System.IO.File).
         IL2CPP keeps the type metadata but strips reflection-only methods like
         Path.Combine, which crashes Android release builds with
         "Method not found: System.IO.Path.Combine". -->
    <assembly fullname="mscorlib">
        <type fullname="System.IO.Path" preserve="all"/>
        <type fullname="System.IO.File" preserve="all"/>
    </assembly>
</linker>
