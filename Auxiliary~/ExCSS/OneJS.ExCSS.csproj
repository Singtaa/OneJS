<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds Runtime/Styling/ExCSS/OneJS.ExCSS.dll and its .pdb from src/ (upstream ExCSS v4.3.2,
    unmodified). Run build.mjs rather than this directly: it builds into a scratch folder and
    copies the two files, or with check compares them byte for byte with the committed ones.

    Every setting below exists so the bytes depend on the source alone, not on the machine or the
    checkout's path. build.mjs supplies the rest: one exact .NET SDK, installed privately, since
    the PDB records the runtime the compiler ran on and that runtime compresses the embedded source.
  -->
  <PropertyGroup>
    <AssemblyName>OneJS.ExCSS</AssemblyName>
    <RootNamespace>ExCSS</RootNamespace>
    <!-- What Unity compiled the source against when it was a folder of .cs files (3.9.15). -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configuration>Release</Configuration>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Unity's own compile of the folder carried no version or framework attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- The same bytes from the same source on every machine. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- Ours, not the SDK's: its own map is from the git root, so a copy outside git kept the real path. -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EmbedAllSources>true</EmbedAllSources>
    <EnableSourceLink>false</EnableSourceLink>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CS0168;CS0219;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!--
    The compiler takes the files in the order listed, and the order changes both outputs. A glob
    sorts by full path, where Windows' \ sorts after a letter and / before one (Border\ after
    BorderImage\, Border/ before BorderImage/), so build.mjs writes the list sorted by /-path.
  -->
  <Import Project="Sources.props" Condition="Exists('Sources.props')" />
  <ItemGroup Condition="!Exists('Sources.props')">
    <Compile Include="src/**/*.cs" />
  </ItemGroup>
</Project>
